files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/01_create_folders.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Create directories
      mkdir -p /var/app/current/images
      mkdir -p /var/app/current/uploads
      
      # Set permissions
      chmod -R 755 /var/app/current/images
      chmod -R 777 /var/app/current/uploads
      
      # Set ownership to webapp (the user PHP runs as)
      chown -R webapp:webapp /var/app/current/images
      chown -R webapp:webapp /var/app/current/uploads
      
      # Log the result
      echo "Created directories at $(date)" >> /var/log/folder_creation.log
      ls -la /var/app/current/ >> /var/log/folder_creation.log

commands:
  01_execute_script:
    command: "sh /opt/elasticbeanstalk/hooks/appdeploy/post/01_create_folders.sh"