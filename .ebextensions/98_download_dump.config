container_commands:
  01_download_and_import_db:
    command: |
      #!/bin/bash
      exec > /tmp/container_db_setup.log 2>&1
      
      echo "Container command starting at $(date)"
      
      # Download
      aws s3 cp s3://gooberbucketgc6788/database_dumps/latest-database-dump.sql /tmp/database_dump.sql
      
      if [ $? -eq 0 ]; then
        echo "Download successful, importing..."
        
        # Get environment variables
        DB_USERNAME=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_USERNAME)
        DB_PASSWORD=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_PASSWORD)
        DB_NAME=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_NAME)
        
        # Fix collation and import
        sed 's/utf8mb4_0900_ai_ci/utf8mb4_general_ci/g' /tmp/database_dump.sql | \
        mysql -u"$DB_USERNAME" -p"$DB_PASSWORD" "$DB_NAME"
        
        echo "Import completed with exit code: $?"
      fi