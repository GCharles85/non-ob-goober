files:
  "/opt/elasticbeanstalk/hooks/appdeploy/pre/98_download_dump.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      
      # Log file for debugging
      exec > >(tee /var/log/dump_download.log) 2>&1
      
      echo "Downloading database dump from S3..."
      
      # Create directory if it doesn't exist
      mkdir -p /var/app/staging

      # Download the dump file from S3
      aws s3 cp s3://gooberbucketgc6788/database_dumps/latest-database-dump.sql /var/app/staging/database_dump.sql
      
      if [ $? -eq 0 ]; then
        echo "Database dump downloaded successfully."
        # Copy to current directory as well for import script
        cp /var/app/staging/database_dump.sql /var/app/current/database_dump.sql 2>/dev/null || echo "Will copy after deployment"
      else
        echo "Failed to download database dump from S3."
      fi