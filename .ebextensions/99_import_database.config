files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_import_database.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      
      # Log file for debugging
      exec > >(tee /tmp/db_import.log) 2>&1
      
      echo "Starting database import process..."

      # Get environment variables from Elastic Beanstalk
      DB_USERNAME=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_USERNAME)
      DB_PASSWORD=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_PASSWORD)
      DB_NAME=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_NAME)
      
      # Path to your SQL dump - check both locations
      DUMP_FILE=""
      if [ -f "/tmp/database_dump.sql" ]; then
        DUMP_FILE="/tmp/database_dump.sql"
        echo "✅ Found dump file in /tmp/"
      elif [ -f "/opt/database_dump.sql" ]; then
        DUMP_FILE="/opt/database_dump.sql"
        echo "✅ Found dump file in /opt/"
      else
        echo "❌ No dump file found!"
        echo "Files in /tmp/:"
        ls -la /tmp/database*
        echo "Files in /opt/:"
        ls -la /opt/database*
        exit 1
      fi
      
      # Wait for MariaDB to be available
      echo "Waiting for MariaDB to be ready..."
      for i in {1..30}; do
        if mysqladmin ping -u$DB_USERNAME -p$DB_PASSWORD --silent; then
          break
        fi
        echo "Waiting for MariaDB to start... ($i/30)"
        sleep 2
      done
      
      # Import the database dump
      echo "Importing database dump..."
      if [ -f "$DUMP_FILE" ]; then
        mysql -u$DB_USERNAME -p$DB_PASSWORD $DB_NAME < $DUMP_FILE
        RESULT=$?
        if [ $RESULT -eq 0 ]; then
          echo "Database import completed successfully."
        else
          echo "Database import failed with error code $RESULT."
        fi
      else
        echo "Error: Database dump file not found at $DUMP_FILE"
      fi

  