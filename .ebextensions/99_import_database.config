files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_import_database.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      
      # Log file for debugging
      exec > >(tee /var/log/db_import.log) 2>&1
      
      echo "Starting database import process..."

      # Get environment variables from Elastic Beanstalk
      DB_USERNAME1=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_USERNAME)
      DB_PASSWORD1=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_PASSWORD)
      DB_NAME=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_NAME)
      
      # Path to your SQL dump (stored in S3 and downloaded during deployment)
      DUMP_FILE="/var/app/current/database_dump.sql"
      
      # Wait for MariaDB to be available
      echo "Waiting for MariaDB to be ready..."
      for i in {1..30}; do
        if mysqladmin ping -u$DB_USERNAME1 -p$DB_PASSWORD1 --silent; then
          break
        fi
        echo "Waiting for MariaDB to start... ($i/30)"
        sleep 2
      done
      
      # Import the database dump
      echo "Importing database dump..."
      if [ -f "$DUMP_FILE" ]; then
        mysql -u$DB_USERNAME1 -p$DB_PASSWORD1 $DB_NAME < $DUMP_FILE
        RESULT=$?
        if [ $RESULT -eq 0 ]; then
          echo "Database import completed successfully."
        else
          echo "Database import failed with error code $RESULT."
        fi
      else
        echo "Error: Database dump file not found at $DUMP_FILE"
      fi

  "/opt/elasticbeanstalk/hooks/configdeploy/post/99_import_database.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Same script as above for config deployments
      # Copy the same content here
      # Log file for debugging
      exec > >(tee /var/log/db_import.log) 2>&1
      
      echo "Starting database import process..."
      
      # Path to your SQL dump (stored in S3 and downloaded during deployment)
      DUMP_FILE="/var/app/current/database_dump.sql"
      
      # Get environment variables from Elastic Beanstalk
      DB_USERNAME1=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_USERNAME1)
      DB_PASSWORD1=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_PASSWORD1)
      DB_NAME$(/opt/elasticbeanstalk/bin/get-config environment -k DB_NAME)
      
      # Wait for MariaDB to be available
      echo "Waiting for MariaDB to be ready..."
      for i in {1..30}; do
        if mysqladmin ping -u$DB_USERNAME1 -p$DB_PASSWORD1 --silent; then
          break
        fi
        echo "Waiting for MariaDB to start... ($i/30)"
        sleep 2
      done
      
      # Import the database dump
      echo "Importing database dump..."
      if [ -f "$DUMP_FILE" ]; then
        mysql -u$DB_USERNAME1 -p$DB_PASS $DB_NAME < $DUMP_FILE
        RESULT=$?
        if [ $RESULT -eq 0 ]; then
          echo "Database import completed successfully."
        else
          echo "Database import failed with error code $RESULT."
        fi
      else
        echo "Error: Database dump file not found at $DUMP_FILE"
      fi
