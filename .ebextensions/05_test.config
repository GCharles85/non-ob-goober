# Create a file called test-hooks.config in .ebextensions/
files:
  "/tmp/test-hook.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      echo "Test hook executed at $(date)" > /tmp/test-hook-output.txt
      echo "Current user: $(whoami)" >> /tmp/test-hook-output.txt

commands:
  01_run_test:
    command: "/tmp/test-hook.sh"