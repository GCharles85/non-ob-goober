packages:
  yum:
    mariadb105: []
    mariadb105-server: []

commands:
  01_start_mariadb:
    command: |
      systemctl enable mariadb.service
      systemctl start mariadb.service
      
      # Wait for MariaDB to be ready
      sleep 5
      
      # Check if MariaDB is running
      systemctl status mariadb
    ignoreErrors: true

  02_secure_mariadb:
    command: |
      # Get the DB password from Elastic Beanstalk environment variables
      DB_PASSWORD=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_PASSWORD)
      
      # For fresh MariaDB installation, root initially has no password
      # Set root password first
      mysqladmin -u root password "${DB_PASSWORD}"
      
      # Alternative method if the above fails - try connecting without password first
      mysql -u root -e "ALTER USER 'root'@'localhost' IDENTIFIED BY '${DB_PASSWORD}';" 2>/dev/null || \
      mysql -u root -p"${DB_PASSWORD}" -e "SELECT 1;" 2>/dev/null || \
      echo "Root password may already be set"
      
    ignoreErrors: true

  03_create_database:
    command: |
      # Get the DB password from Elastic Beanstalk environment variables
      DB_PASSWORD=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_PASSWORD)
      
      # Now use the password for all operations
      mysql -u root -p"${DB_PASSWORD}" -e "CREATE DATABASE IF NOT EXISTS goober_box;"
      mysql -u root -p"${DB_PASSWORD}" -e "CREATE USER IF NOT EXISTS 'app_user'@'localhost' IDENTIFIED BY '${DB_PASSWORD}';"
      mysql -u root -p"${DB_PASSWORD}" -e "GRANT ALL PRIVILEGES ON goober_box.* TO 'app_user'@'localhost';"
      mysql -u root -p"${DB_PASSWORD}" -e "FLUSH PRIVILEGES;"
    ignoreErrors: true