files:
  "/opt/update-db-dump.sh":
    mode: "000755"
    owner: root
    group: www-data
    content: |
      #!/bin/bash
      
      # Log output
      exec > >(tee /tmp/db-dump-$(date +%Y%m%d%H%M%S).log) 2>&1
      
      # Get environment variables from Elastic Beanstalk
      DB_USERNAME1=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_USERNAME1)
      DB_PASSWORD1=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_PASSWORD1)
      DB_NAME=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_NAME)
      
      echo "Creating database dump and uploading to S3..."
      echo "Using database: $DB_NAME"
      
      # Create the dump and upload to S3
      mysqldump -u"${DB_USERNAME1}" -p"${DB_PASSWORD1}" --opt --single-transaction --routines --triggers "${DB_NAME}" | aws s3 cp - s3://gooberbucketgc6788/database_dumps/latest-database-dump.sql
      
      if [ $? -eq 0 ]; then
        echo "Database dump completed and uploaded to S3 successfully."
      else
        echo "Database dump failed."
        exit 1
      fi