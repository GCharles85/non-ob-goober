files:
  "/opt/update-db-dump.sh":
    mode: "000755"
    owner: root
    group: apache
    content: |
      #!/bin/bash
      
      # Log output
      echo "Creating database dump and uploading to S3..." >> /tmp/db-dump-$(date +%Y%m%d%H%M%S).log
      
      # Get environment variables from Elastic Beanstalk
      DB_USERNAME=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_USERNAME)
      DB_PASSWORD=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_PASSWORD)
      DB_NAME=$(/opt/elasticbeanstalk/bin/get-config environment -k DB_NAME)
      
      echo "Creating database dump and uploading to S3..." >> /tmp/db-dump-$(date +%Y%m%d%H%M%S).log
      echo "Using database: $DB_NAME" >> /tmp/db-dump-$(date +%Y%m%d%H%M%S).log
      
      # Create the dump and upload to S3
      mysqldump -u"${DB_USERNAME}" -p"${DB_PASSWORD}" --opt --single-transaction --routines --triggers "${DB_NAME}" | aws s3 cp - s3://gooberbucketgc6788/database_dumps/latest-database-dump.sql
      
      if [ $? -eq 0 ]; then
        echo "Database dump completed and uploaded to S3 successfully." >> /tmp/db-dump-$(date +%Y%m%d%H%M%S).log
      else
        echo "Database dump failed." >> /tmp/db-dump-$(date +%Y%m%d%H%M%S).log
        exit 1
      fi