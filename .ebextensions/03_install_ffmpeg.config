packages:
  yum:
    ImageMagick: []
    ImageMagick-devel: []

commands:
  01_install_ffmpeg:
    # Only download/install when ffmpeg isn't already on the instance.
    # Makes redeploys independent of the external download host.
    test: "[ ! -x /usr/bin/ffmpeg ]"
    command: |
      set -e
      wget -O /tmp/ffmpeg.tar.xz https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz
      mkdir -p /opt/ffmpeg
      tar xf /tmp/ffmpeg.tar.xz -C /opt/ffmpeg
      ln -sf /opt/ffmpeg/ffmpeg-*-amd64-static/ffmpeg /usr/bin/ffmpeg
      ln -sf /opt/ffmpeg/ffmpeg-*-amd64-static/ffprobe /usr/bin/ffprobe
  02_install_imagick:
    # Best-effort PHP imagick; never fail a deploy over it.
    test: "! php -m | grep -qi imagick"
    command: "pecl install -f imagick || true"
    ignoreErrors: true
